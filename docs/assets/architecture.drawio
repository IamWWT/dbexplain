<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dbexplain-architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="dbexplain Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="350" y="15" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- ============ Stage 1: INPUT ============ -->
        <mxCell id="s1" value="① INPUT: Connection &amp; Config" style="swimlane;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#dae8fc;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="860" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s1b1" value="• DSN strings, .env.dbexplain, JSON config — 6-level auto-search with encrypted .enc support" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s1">
          <mxGeometry x="20" y="40" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s1b2" value="• CLI flags: -include/-exclude filter, --conn concurrency, -timeout, --human, --context, --cache" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s1">
          <mxGeometry x="20" y="64" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s1b3" value="• Encrypted config (XChaCha20-Poly1305) — machine-fingerprint bound, auto-decrypt on load" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s1">
          <mxGeometry x="20" y="88" width="820" height="22" as="geometry" />
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Stage 2: COLLECT ============ -->
        <mxCell id="s2" value="② COLLECT: Schema Extraction" style="swimlane;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#d5e8d4;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="235" width="860" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s2b1" value="• 9 DB connectors: MySQL, PostgreSQL, GaussDB, ClickHouse, SQLite, Redis, ES, MongoDB, Qdrant" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s2">
          <mxGeometry x="20" y="40" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s2b2" value="• Extracts: tables → columns (name/type/nullable), indexes, foreign keys, row estimates, sampling" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s2">
          <mxGeometry x="20" y="64" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s2b3" value="• Read-only execution: SELECT/SHOW/PRAGMA only — never writes, modifies, or deletes data" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s2">
          <mxGeometry x="20" y="88" width="820" height="22" as="geometry" />
        </mxCell>

        <!-- Arrow 2→3 -->
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Stage 3: ANALYZE ============ -->
        <mxCell id="s3" value="③ ANALYZE: Structure &amp; Context" style="swimlane;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#fff2cc;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="860" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s3b1" value="• FK extraction (explicit DDL + inferred by naming patterns), relationship clustering (Union-Find)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s3">
          <mxGeometry x="20" y="40" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3b2" value="• Table ranking (6 weighted factors), diagnostics (unindexed FK, missing PK, no TTL)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s3">
          <mxGeometry x="20" y="64" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3b3" value="• IR Graph (node/edge primitives) + context compression (summary / topology / diagnostics / chunks)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s3">
          <mxGeometry x="20" y="88" width="820" height="22" as="geometry" />
        </mxCell>

        <!-- Arrow 3→4 -->
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Stage 4: OUTPUT ============ -->
        <mxCell id="s4" value="④ OUTPUT: AI-Ready Reports" style="swimlane;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#e1d5e7;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="545" width="860" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s4b1" value="• Terminal Markdown (ANSI table cards, relationship sections, diagnostics) — human-friendly" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s4">
          <mxGeometry x="20" y="40" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s4b2" value="• JSON output (structured IR: instances/tables/columns/refs/groups/issues) — AI Agent consumption" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s4">
          <mxGeometry x="20" y="64" width="820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s4b3" value="• Context files: summary.json + topology.json + diagnostics.json + chunks/*.md — for agent prompts" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacingLeft=8;" vertex="1" parent="s4">
          <mxGeometry x="20" y="88" width="820" height="22" as="geometry" />
