# dbexplain 配置文件模板
# 安装后自动复制到 ~/.config/dbexplain/.env.dbexplain
# 或将此文件复制到 ~/.config/dbexplain/ 目录下重命名为 .env.dbexplain
#
# 格式: DB<n>=<scheme>://[user:pass@]host[:port][/db][?label=别名&参数]
# 编号无需连续，程序会自动按数字升序加载
#
# 配置文件搜索优先级 (dbexplain 自动加载):
#   1. DBPROBE_ENV_FILE 环境变量（显式覆盖）
#   2. ./.env.dbexplain（当前目录）
#   3. ./.env.dbexplain.enc（当前目录，加密）
#   4. ~/.config/dbexplain/.env.dbexplain（用户配置目录）
#   5. ~/.config/dbexplain/.env.dbexplain.enc（用户配置目录，加密）
#   6. ./.env（当前目录，旧版兼容）
#   7. ./.env.enc（当前目录，旧版加密兼容）

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 安全策略配置 (v0.0.9+)
# 用于 dbexplain execute 的细粒度访问控制。
# 支持全局（所有 DSN）和按 DSN 索引生效。
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# 全局: 禁止查询这些表 (对所有数据库生效)
# DENY_TABLES=sensitive_data,audit_log,user_credentials

# 全局: 禁止查询这些字段 (schema.table.column 或 table.column 格式)
# DENY_COLUMNS=users.password_hash,orders.card_number,employees.salary

# 全局: 禁止执行匹配这些模式的语句 (大小写不敏感子串匹配)
# DENY_STATEMENTS=DROP TABLE,ALTER TABLE,FLUSHALL,SHUTDOWN

# 按 DSN 索引: 仅 DB2 禁止查询 audit_log
# DB2_DENY_TABLES=internal_audit

# 按 DSN 索引: 仅 DB5 (Redis) 禁止执行高危命令
# DB5_DENY_STATEMENTS=FLUSHALL,FLUSHDB,CONFIG,SHUTDOWN

# 按 DSN 索引: 仅 DB7 (MongoDB) 禁止查询特定集合
# DB7_DENY_TABLES=system.users,system.profile

# 全局: 列值替换屏蔽 (v0.0.9+)
# 替代 DENY_COLUMNS 的硬阻断，改为将敏感列值替换为指定字符串
# 格式: MASK_COLUMNS=列名=替换文本,列名2=替换文本2
# 支持通配符 (*, ?) 和 table. 前缀
# MASK_COLUMNS=password_hash=***,card_number=****-****-****-****,email=REDACTED
# DB2_MASK_COLUMNS=phone=HIDDEN

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 数据库 DSN 配置
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# MySQL
# DB1=mysql://user:password@localhost:3306/mydb?label=my-mysql

# PostgreSQL
# DB2=postgres://user:password@localhost:5432/mydb?label=my-pg

# GaussDB（兼容 PostgreSQL 协议，支持 Oracle 兼容模式）
# 注：Oracle 兼容模式下 datistemplate 列缺失、EXPLAIN 无 BUFFERS
# 设置 oracleCompatible=true 可跳过 PG 模式查询尝试，避免日志中的失败记录
# DB3=gaussdb://user:password@host:5432/mydb?label=my-gaussdb                    # PG 兼容模式（默认）
# DB3=gaussdb://user:password@host:5432/mydb?oracleCompatible=true&label=my-gaussdb-oracle  # Oracle 兼容模式

# ClickHouse
# DB4=clickhouse://default:password@localhost:8123/default?label=my-ch

# SQLite
# DB5=sqlite:///absolute/path/to/database.db?label=my-sqlite

# Redis
# DB6=redis://:password@localhost:6379/0?label=my-redis

# Redis Cluster
# DB7=redis://:password@host:7000/0?cluster=true&label=my-cluster

# MongoDB (必须指定库名)
# DB8=mongodb://user:password@localhost:27017/mydb?authSource=admin&label=my-mongo

# Elasticsearch
# DB9=elasticsearch://elastic:password@localhost:9200?label=my-es

# Qdrant
# DB10=qdrant://:api-key@localhost:6334?label=my-qdrant

# CSV/TSV 文件（单文件模式）
# DB11=csv:///path/to/file.csv?label=my-csv
# DB12=tsv:///path/to/file.tsv?label=my-tsv

# CSV 目录模式（扫描目录下所有 .csv 文件）
# DB13=csv:///path/to/directory/?label=my-csv-dir

# CSV Glob 通配符模式
# DB14=csv:///path/to/dir/*.csv?label=my-csv-glob

# XLSX Excel 文件（需要 -tags xlsx 构建）
# DB15=xlsx:///path/to/file.xlsx?label=my-xlsx

# DuckDB 嵌入式分析引擎（需要 -tags duckdb 构建，标准版不含）
# DB16=duckdb:///path/to/database.duckdb?label=my-duckdb

# DuckDB 内存模式
# DB17=duckdb://?label=my-duckdb-mem

# Prometheus 时序数据库
# DB18=prometheus://localhost:9090?label=my-prom

# Prometheus HTTPS + 超时配置
# DB19=prometheus://prom.example.com:443?tls=true&timeout=15&label=prom-prod

# Oracle 数据库（12c+ 需要 FETCH FIRST 支持）
# DB20=oracle://user:password@host:1521/XEPDB1?label=my-oracle

# Oracle TLS（oracles:// 自动启用 TLS）
# DB21=oracles://user:password@host:1521/XEPDB1?ssl=true&label=my-oracle-tls
# DB22=oracle://user:password@host:1521/ORCL?ssl=true&label=my-oracle-ssl

# Hive 数据仓库（NOSASL 认证）
# DB23=hive://user@host:10000/warehouse?auth=NOSASL&label=my-hive

# Hive LDAP 认证
# DB24=hive://user:password@host:10000/default?auth=LDAP&label=hive-prod

# Hive Kerberos 认证
# DB25=hive://user@host:10000/default?auth=KERBEROS&service=hive&label=hive-kerb
