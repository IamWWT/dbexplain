# dbexplain 配置文件模板
# 安装后自动复制到 ~/.config/dbexplain/.env.dbexplain
# 或将此文件复制到 ~/.config/dbexplain/ 目录下重命名为 .env.dbexplain
#
# 格式: DB<n>=<scheme>://[user:pass@]host[:port][/db][?label=别名&参数]
# 编号无需连续，程序会自动按数字升序加载
#
# 配置文件搜索优先级 (dbexplain -env):
#   1. DBPROBE_ENV_FILE 环境变量
#   2. ./.env.dbexplain
#   3. ~/.config/dbexplain/.env.dbexplain

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 安全策略配置 (v0.0.9+)
# 用于 dbexplain execute 的细粒度访问控制。
# 支持全局（所有 DSN）和按 DSN 索引生效。
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# 全局: 禁止查询这些表 (对所有数据库生效)
# DENY_TABLES=sensitive_data,audit_log,user_credentials

# 全局: 禁止查询这些字段 (schema.table.column 或 table.column 格式)
# DENY_COLUMNS=users.password_hash,orders.card_number,employees.salary

# 全局: 禁止执行匹配这些模式的语句 (大小写不敏感子串匹配)
# DENY_STATEMENTS=DROP TABLE,ALTER TABLE,FLUSHALL,SHUTDOWN

# 按 DSN 索引: 仅 DB2 禁止查询 audit_log
# DB2_DENY_TABLES=internal_audit

# 按 DSN 索引: 仅 DB5 (Redis) 禁止执行高危命令
# DB5_DENY_STATEMENTS=FLUSHALL,FLUSHDB,CONFIG,SHUTDOWN

# 按 DSN 索引: 仅 DB7 (MongoDB) 禁止查询特定集合
# DB7_DENY_TABLES=system.users,system.profile

# 全局: 列值替换屏蔽 (v0.0.9+)
# 替代 DENY_COLUMNS 的硬阻断，改为将敏感列值替换为指定字符串
# 格式: MASK_COLUMNS=列名=替换文本,列名2=替换文本2
# 支持通配符 (*, ?) 和 table. 前缀
# MASK_COLUMNS=password_hash=***,card_number=****-****-****-****,email=REDACTED
# DB2_MASK_COLUMNS=phone=HIDDEN

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 数据库 DSN 配置
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# MySQL
# DB1=mysql://user:password@localhost:3306/mydb?label=my-mysql
# DB1=mysql://user:password@localhost:3306/mydb?label=my-mysql

# PostgreSQL
# DB2=postgres://user:password@localhost:5432/mydb?label=my-pg

# ClickHouse
# DB3=clickhouse://default:password@localhost:8123/default?label=my-ch

# SQLite
# DB4=sqlite:///absolute/path/to/database.db?label=my-sqlite

# Redis
# DB5=redis://:password@localhost:6379/0?label=my-redis

# Redis Cluster
# DB6=redis://:password@host:7000/0?cluster=true&label=my-cluster

# MongoDB (必须指定库名)
# DB7=mongodb://user:password@localhost:27017/mydb?authSource=admin&label=my-mongo

# Elasticsearch
# DB8=elasticsearch://elastic:password@localhost:9200?label=my-es

# Qdrant
# DB9=qdrant://:api-key@localhost:6334?label=my-qdrant

# CSV/TSV 文件（单文件模式）
# DB10=csv:///path/to/file.csv?label=my-csv
# DB11=tsv:///path/to/file.tsv?label=my-tsv

# CSV 目录模式（扫描目录下所有 .csv 文件）
# DB12=csv:///path/to/directory/?label=my-csv-dir

# CSV Glob 通配符模式
# DB13=csv:///path/to/dir/*.csv?label=my-csv-glob

# XLSX Excel 文件（需要 -tags excel 构建）
# DB14=xlsx:///path/to/file.xlsx?label=my-xlsx
