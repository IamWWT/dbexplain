# Account Manager Skill - 环境配置示例
#
# 使用方式:
#   dbexplain
#   dbexplain list
#   dbexplain execute --label touch-ops-csv 'SELECT ...' --human
#
# 注意: /path/to 替换为实际文件路径

# CSV 数据源（客户经理触达运营）
DB1=csv:///path/to/pb_touch_ops_sample_2000.csv?label=touch-ops-csv
DB2=csv:///path/to/t_sec_org_sample.csv?label=sec-org

# XLSX 数据源
DB3=xlsx:///path/to/data.xlsx?label=report-xlsx

# MySQL / MariaDB
# DB4=mysql://user:password@127.0.0.1:3306/dbname?label=my-mysql

# SQLite
# DB5=sqlite:///path/to/database.db?label=my-sqlite

# Elasticsearch
# DB6=es://user:password@127.0.0.1:9200?label=my-es

# 安全策略（可选）
# DENY_TABLES=t_sec_org_sample,salary_info              # 禁止访问的表，精确表名（不含路径），逗号分隔
# MASK_COLUMNS=csmgr_refno=****,pnbrn_org_name=****    # 列名=替换值，逗号分隔（查询结果中这些列将显示为 ****）
